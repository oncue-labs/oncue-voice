# 평가에 사용할 provider: fake 또는 openai
ONCUE_EVALUATION_PROVIDER=fake
ONCUE_EVALUATION_ARTIFACT_ROOT=notebooks/evaluations

# OpenAI 평가를 사용할 때만 입력한다. 이 파일에는 실제 key를 넣지 않는다.
OPENAI_API_KEY=

# OpenAI 평가용 합성 입력 음성 파일 경로
# 분리형 pipeline: tests/fixtures/evaluation/input.wav
# Realtime: tests/fixtures/evaluation/input.pcm
ONCUE_EVALUATION_AUDIO_PATH=

# 분리형 pipeline 설정
OPENAI_LLM_MODEL=gpt-5-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_VOICE_ID=alloy
OPENAI_TTS_SPEED=1.0

# Realtime 설정
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=alloy
